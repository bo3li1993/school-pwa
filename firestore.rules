rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ³ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¹ط·آ·ط¢آ¢ط·آ¢ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¯ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¢ط·آ¢ط¢آ¦ token claims ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¢ط·آ¢ط¢آ¦ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¨ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ´ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ±ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ© ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¨ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¯ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬آ  ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¹ط£آ¢أ¢â€ڑآ¬ط¹آ©ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ±ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¥ط£آ¢أ¢â€ڑآ¬أ¢â€‍آ¢ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ© Firestore
    function userSchool() {
      return request.auth.token.schoolId;
    }

    function userRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuth() && userRole() in ["admin", "assistant_manager", "wing_supervisor", "department_head"];
    }

    function isFullAdmin() {
      return isAuth() && userRole() in ["admin", "assistant_manager"];
    }

    function isSuperAdmin() {
      return isAuth() && (request.auth.token.superadmin == true || request.auth.token.role == "superadmin");
    }

    function isTeacher() {
      return isAuth() && userRole() in ["teacher", "social_worker", "nurse", "guard", "wing_supervisor", "department_head"];
    }

    function isParent() {
      return isAuth() && request.auth.token.role == "parent";
    }

    function sameSchool(schoolId) {
      return isAuth() && userSchool() == schoolId;
    }

    function isSchoolStaff(schoolId) {
      return sameSchool(schoolId) && (isAdmin() || isTeacher());
    }

    function roleNotChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId']);
    }

    function schoolIdNotChanged() {
      return request.resource.data.schoolId == resource.data.schoolId;
    }

    // Schools
    match /schools/{schoolId} {
      allow read: if isSuperAdmin()
        || (isAuth() && userSchool() == schoolId)
        || (!isAuth());
      allow write: if isSuperAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() && sameSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow create: if false;
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) &&
        roleNotChanged() &&
        schoolIdNotChanged() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["passHash", "userId", "childIds", "createdAt", "passwordResetRequired", "resetAt"]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "email", "phone", "department", "classId", "status"]);
    }

    // Students
       match /students/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) && resource.data.studentId in request.auth.token.childIds &&
          resource.data.studentId in request.auth.token.childIds
      );
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Attendance
    match /attendance/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) && resource.data.studentId in request.auth.token.childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Behavior
    match /behavior/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) && resource.data.studentId in request.auth.token.childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Warnings
    match /warnings/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) && resource.data.studentId in request.auth.token.childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Gatepass
    match /gatepass/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Clinic
    match /clinic/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Classes
    match /classes/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Departments
    match /departments/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Announcements
    match /announcements/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // School announcements (for login page branding)
    match /school_announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin() && sameSchool(request.resource.data.schoolId);
    }

    // School threads
    match /school_threads/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && sameSchool(resource.data.schoolId) && schoolIdNotChanged() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Honors board
    match /honors_board/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Rewards
    match /rewards/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Technical visits
    match /technical_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Manager visits
    match /manager_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Wing rounds
    match /wing_rounds/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Audit log
    match /audit_log/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // Backups
    match /backups/{docId} {
      allow read: if isFullAdmin() && sameSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // Notifications queue
    match /notifications_queue/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // Archive
    match /archive_attendance/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_behavior/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_warnings/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // Graduates
    match /graduates/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Promotion logs
    match /promotion_logs/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // Deleted students
    match /deleted_students/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // Class distribution
    match /class_distribution/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isFullAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Subscription logs
    match /subscription_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Login attempts - server only
    match /login_attempts/{docId} {
      allow read, write: if false;
    }

    // OTP
    match /otp_requests/{phone} { allow read, write: if false; }
    match /otp_rate_limits/{docId} { allow read, write: if false; }

    // Visitors
    match /visitors/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId);
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    match /visitors_logs/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Visits
    match /visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId);
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Student notes
    match /student_notes/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // Principal chats
    match /principal_chats/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isFullAdmin() && sameSchool(resource.data.schoolId);
      allow delete: if isFullAdmin() && sameSchool(resource.data.schoolId);
    }

    // System config
    match /system_config/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Parent accounts
    match /parent_accounts/{docId} {
      allow read: if isAuth() && (isAdmin() && sameSchool(resource.data.schoolId) || request.auth.uid == docId);
      allow write: if false;
    }

    // user_secrets - passHash ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ ط·آ·ط¢آ¸ط·آ¸ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آµط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع† ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ·ط·آ·أ¢â‚¬ط›ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¹â€ک ط·آ·ط¢آ·ط·آ¹ط¢آ¾ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¹
    match /user_secrets/{docId} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}
