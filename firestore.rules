rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userSchool() {
      return getUser().schoolId;
    }

    function userRole() {
      return getUser().role;
    }

    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'assistant_manager'];
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }

    function isTeacher() {
      return isAuth() && userRole() in ['teacher', 'social_worker', 'nurse', 'guard', 'wing_supervisor', 'department_head'];
    }

    function isParent() {
      return isAuth() && userRole() == 'parent';
    }

    function sameSchool(schoolId) {
      return isAuth() && userSchool() == schoolId;
    }

    function isSchoolStaff(schoolId) {
      return sameSchool(schoolId) && (isAdmin() || isTeacher());
    }

    // طھط­ظ‚ظ‚: ظ„ط§ ظٹظ…ظƒظ† طھط؛ظٹظٹط± role ط£ظˆ schoolId
    function roleNotChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId']);
    }

    // طھط­ظ‚ظ‚: schoolId ظ„ط§ ظٹطھط؛ظٹط± ط¹ظ†ط¯ Update
    function schoolIdNotChanged() {
      return request.resource.data.schoolId == resource.data.schoolId;
    }

    // â•گâ•گ ط§ظ„ظ…ط¯ط§ط±ط³ â•گâ•گ
    match /schools/{schoolId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // â•گâ•گ ط§ظ„ظ…ط³طھط®ط¯ظ…ظˆظ† â•گâ•گ
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() && sameSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId) &&
        !request.resource.data.role.matches('superadmin');
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) &&
        roleNotChanged() &&
        schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط·ظ„ط§ط¨ â•گâ•گ
    match /students/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط­ط¶ظˆط± ظˆط§ظ„ط؛ظٹط§ط¨ â•گâ•گ
    match /attendance/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط³ظ„ظˆظƒ â•گâ•گ
    match /behavior/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط¥ظ†ط°ط§ط±ط§طھ â•گâ•گ
    match /warnings/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط§ط³طھط¦ط°ط§ظ† â•گâ•گ
    match /gatepass/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط¹ظٹط§ط¯ط© â•گâ•گ
    match /clinic/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ظپطµظˆظ„ â•گâ•گ
    match /classes/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط£ظ‚ط³ط§ظ… â•گâ•گ
    match /departments/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط¥ط¹ظ„ط§ظ†ط§طھ â•گâ•گ
    match /announcements/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„طµظ†ط¯ظˆظ‚ ط§ظ„ط¨ط±ظٹط¯ظٹ â•گâ•گ
    match /school_threads/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isAuth() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ظ„ظˆط­ط© ط§ظ„ط´ط±ظپ â•گâ•گ
    match /honors_board/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ظ…ظƒط§ظپط¢طھ â•گâ•گ
    match /rewards/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط§ظ„ط²ظٹط§ط±ط§طھ ط§ظ„ظپظ†ظٹط© â•گâ•گ
    match /technical_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط²ظٹط§ط±ط§طھ ط§ظ„ظ…ط¯ظٹط± â•گâ•گ
    match /manager_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط¬ظˆظ„ط§طھ ط§ظ„ظ…ط´ط±ظپ â•گâ•گ
    match /wing_rounds/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط³ط¬ظ„ ط§ظ„طھط¯ظ‚ظٹظ‚ â€” ظ…ظ†ط¹ ط§ظ„طھط²ظˆظٹط± â•گâ•گ
    match /audit_log/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // â•گâ•گ ط§ظ„ظ†ط³ط® ط§ظ„ط§ط­طھظٹط§ط·ظٹط© â•گâ•گ
    match /backups/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // â•گâ•گ ظ‚ط§ط¦ظ…ط© ط§ظ†طھط¸ط§ط± ط§ظ„ط¥ط´ط¹ط§ط±ط§طھ â•گâ•گ
    match /notifications_queue/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // â•گâ•گ ظ…ط­ط§ظˆظ„ط§طھ ط§ظ„ط¯ط®ظˆظ„ â•گâ•گ
    match /login_attempts/{docId} {
      allow read, write: if false;
    }

    // â•گâ•گ ط§ظ„ط£ط±ط´ظٹظپ â•گâ•گ
    match /archive_attendance/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_behavior/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_warnings/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // â•گâ•گ ط§ظ„ط®ط±ظٹط¬ظˆظ† â€” ظ…ط¹ sameSchool â•گâ•گ
    match /graduates/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط³ط¬ظ„ط§طھ ط§ظ„طھط±ظ‚ظٹط© â€” ظ…ط¹ sameSchool â•گâ•گ
    match /promotion_logs/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // â•گâ•گ ط§ظ„ط·ظ„ط§ط¨ ط§ظ„ظ…ط­ط°ظˆظپظˆظ† â€” ظ…ط¹ sameSchool â•گâ•گ
    match /deleted_students/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // â•گâ•گ طھظˆط²ظٹط¹ ط§ظ„ظپطµظˆظ„ â€” ظ…ط¹ sameSchool â•گâ•گ
    match /class_distribution/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // â•گâ•گ ط³ط¬ظ„ط§طھ ط§ظ„ط§ط´طھط±ط§ظƒ â•گâ•گ
    match /subscription_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // â•گâ•گ ط§ظ„ظ…ظ†ط¹ ط§ظ„ط§ظپطھط±ط§ط¶ظٹ â•گâ•گ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}