rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userSchool() {
      return getUser().schoolId;
    }

    function userRole() {
      return getUser().role;
    }

    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'assistant_manager'];
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }

    function isTeacher() {
      return isAuth() && userRole() in ['teacher', 'social_worker', 'nurse', 'guard', 'wing_supervisor', 'department_head'];
    }

    function isParent() {
      return isAuth() && userRole() == 'parent';
    }

    function sameSchool(schoolId) {
      return isAuth() && userSchool() == schoolId;
    }

    function isSchoolStaff(schoolId) {
      return sameSchool(schoolId) && (isAdmin() || isTeacher());
    }

    // ط·آ·ط¢آ·ط·آ¹ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آ­ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¹â€ک: ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ§ ط·آ·ط¢آ¸ط·آ¸ط¢آ¹ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ¸ط·آ¦أ¢â‚¬â„¢ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ  ط·آ·ط¢آ·ط·آ¹ط¢آ¾ط·آ·ط¢آ·ط·آ·أ¢â‚¬ط›ط·آ·ط¢آ¸ط·آ¸ط¢آ¹ط·آ·ط¢آ¸ط·آ¸ط¢آ¹ط·آ·ط¢آ·ط·آ¢ط¢آ± role ط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ  schoolId
    function roleNotChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId']);
    }

    // ط·آ·ط¢آ·ط·آ¹ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آ­ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¹â€ک: schoolId ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ§ ط·آ·ط¢آ¸ط·آ¸ط¢آ¹ط·آ·ط¢آ·ط·آ¹ط¢آ¾ط·آ·ط¢آ·ط·آ·أ¢â‚¬ط›ط·آ·ط¢آ¸ط·آ¸ط¢آ¹ط·آ·ط¢آ·ط·آ¢ط¢آ± ط·آ·ط¢آ·ط·آ¢ط¢آ¹ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ ط·آ·ط¢آ·ط·آ¢ط¢آ¯ Update
    function schoolIdNotChanged() {
      return request.resource.data.schoolId == resource.data.schoolId;
    }

    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ·ط·آ¢ط¢آ¯ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ±ط·آ·ط¢آ·ط·آ¢ط¢آ³ ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /schools/{schoolId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ·ط·آ¢ط¢آ³ط·آ·ط¢آ·ط·آ¹ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آ®ط·آ·ط¢آ·ط·آ¢ط¢آ¯ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ  ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() && sameSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow create: if false;
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) &&
        roleNotChanged() &&
        schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ¨ ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /students/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ­ط·آ·ط¢آ·ط·آ¢ط¢آ¶ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ ط·آ·ط¢آ·ط·آ¢ط¢آ± ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ·أ¢â‚¬ط›ط·آ·ط¢آ¸ط·آ¸ط¢آ¹ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ·ط·آ¢ط¢آ¨ ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /attendance/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ³ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ ط·آ·ط¢آ¸ط·آ¦أ¢â‚¬â„¢ ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /behavior/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
