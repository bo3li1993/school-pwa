    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ¸ط·آ«أ¢â‚¬آ ط·آ·ط¢آ·ط·آ¢ط¢آ­ط·آ·ط¢آ·ط·آ¢ط¢آ© ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ·ط·آ¢ط¢آ´ط·آ·ط¢آ·ط·آ¢ط¢آ±ط·آ·ط¢آ¸ط·آ¸ط¢آ¾ ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /honors_board/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬أ¢â‚¬ع†ط·آ·ط¢آ¸ط£آ¢أ¢â€ڑآ¬ط¢آ¦ط·آ·ط¢آ¸ط·آ¦أ¢â‚¬â„¢ط·آ·ط¢آ·ط·آ¢ط¢آ§ط·آ·ط¢آ¸ط·آ¸ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ·ط·آ¹ط¢آ¾ ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط·آ¹ط¢آ¯
    match /rewards/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
