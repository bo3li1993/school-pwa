rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userSchool() {
      return getUser().schoolId;
    }

    function userRole() {
      return getUser().role;
    }

    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'assistant_manager'];
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }

    function isTeacher() {
      return isAuth() && userRole() in ['teacher', 'social_worker', 'nurse', 'guard', 'wing_supervisor', 'department_head'];
    }

    function isParent() {
      return isAuth() && userRole() == 'parent';
    }

    function sameSchool(schoolId) {
      return isAuth() && userSchool() == schoolId;
    }

    function isSchoolStaff(schoolId) {
      return sameSchool(schoolId) && (isAdmin() || isTeacher());
    }

    // ط·آ·ط¹آ¾ط·آ·ط¢آ­ط·آ¸أ¢â‚¬ع‘ط·آ¸أ¢â‚¬ع‘: ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ ط·آ¸ط¸آ¹ط·آ¸أ¢â‚¬آ¦ط·آ¸ط¦â€™ط·آ¸أ¢â‚¬آ  ط·آ·ط¹آ¾ط·آ·ط·â€؛ط·آ¸ط¸آ¹ط·آ¸ط¸آ¹ط·آ·ط¢آ± role ط·آ·ط¢آ£ط·آ¸ط«â€  schoolId
    function roleNotChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId']);
    }

    // ط·آ·ط¹آ¾ط·آ·ط¢آ­ط·آ¸أ¢â‚¬ع‘ط·آ¸أ¢â‚¬ع‘: schoolId ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ ط·آ¸ط¸آ¹ط·آ·ط¹آ¾ط·آ·ط·â€؛ط·آ¸ط¸آ¹ط·آ·ط¢آ± ط·آ·ط¢آ¹ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ Update
    function schoolIdNotChanged() {
      return request.resource.data.schoolId == resource.data.schoolId;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /schools/{schoolId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ·ط¢آ®ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ¸أ¢â‚¬آ  ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() && sameSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow create: if false;
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) &&
        roleNotChanged() &&
        schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ·ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¢آ¨ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /students/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ­ط·آ·ط¢آ¶ط·آ¸ط«â€ ط·آ·ط¢آ± ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط·â€؛ط·آ¸ط¸آ¹ط·آ·ط¢آ§ط·آ·ط¢آ¨ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /attendance/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ³ط·آ¸أ¢â‚¬â€چط·آ¸ط«â€ ط·آ¸ط¦â€™ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /behavior/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¥ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ°ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /warnings/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ·ط¢آ¦ط·آ·ط¢آ°ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ  ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /gatepass/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¹ط·آ¸ط¸آ¹ط·آ·ط¢آ§ط·آ·ط¢آ¯ط·آ·ط¢آ© ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /clinic/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸ط¸آ¾ط·آ·ط¢آµط·آ¸ط«â€ ط·آ¸أ¢â‚¬â€چ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /classes/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ£ط·آ¸أ¢â‚¬ع‘ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /departments/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¥ط·آ·ط¢آ¹ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /announcements/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آµط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ¸ط«â€ ط·آ¸أ¢â‚¬ع‘ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¨ط·آ·ط¢آ±ط·آ¸ط¸آ¹ط·آ·ط¢آ¯ط·آ¸ط¸آ¹ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /school_threads/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isAuth() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ¸أ¢â‚¬â€چط·آ¸ط«â€ ط·آ·ط¢آ­ط·آ·ط¢آ© ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ´ط·آ·ط¢آ±ط·آ¸ط¸آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /honors_board/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ¸ط¦â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¢آ¢ط·آ·ط¹آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /rewards/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ²ط·آ¸ط¸آ¹ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸ط¸آ¾ط·آ¸أ¢â‚¬آ ط·آ¸ط¸آ¹ط·آ·ط¢آ© ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /technical_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ²ط·آ¸ط¸آ¹ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¯ط·آ¸ط¸آ¹ط·آ·ط¢آ± ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /manager_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ¬ط·آ¸ط«â€ ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ´ط·آ·ط¢آ±ط·آ¸ط¸آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /wing_rounds/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ³ط·آ·ط¢آ¬ط·آ¸أ¢â‚¬â€چ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¹آ¾ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬ع‘ط·آ¸ط¸آ¹ط·آ¸أ¢â‚¬ع‘ ط£آ¢أ¢â€ڑآ¬أ¢â‚¬â€Œ ط·آ¸أ¢â‚¬آ¦ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¹ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¹آ¾ط·آ·ط¢آ²ط·آ¸ط«â€ ط·آ¸ط¸آ¹ط·آ·ط¢آ± ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /audit_log/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ ط·آ·ط¢آ³ط·آ·ط¢آ® ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¢آ­ط·آ·ط¹آ¾ط·آ¸ط¸آ¹ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ¸ط¸آ¹ط·آ·ط¢آ© ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /backups/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ¸أ¢â‚¬ع‘ط·آ·ط¢آ§ط·آ·ط¢آ¦ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ© ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ·ط¹آ¾ط·آ·ط¢آ¸ط·آ·ط¢آ§ط·آ·ط¢آ± ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¥ط·آ·ط¢آ´ط·آ·ط¢آ¹ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /notifications_queue/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ­ط·آ·ط¢آ§ط·آ¸ط«â€ ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¯ط·آ·ط¢آ®ط·آ¸ط«â€ ط·آ¸أ¢â‚¬â€چ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /login_attempts/{docId} {
      allow read, write: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ£ط·آ·ط¢آ±ط·آ·ط¢آ´ط·آ¸ط¸آ¹ط·آ¸ط¸آ¾ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /archive_attendance/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_behavior/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_warnings/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ®ط·آ·ط¢آ±ط·آ¸ط¸آ¹ط·آ·ط¢آ¬ط·آ¸ط«â€ ط·آ¸أ¢â‚¬آ  ط£آ¢أ¢â€ڑآ¬أ¢â‚¬â€Œ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¹ sameSchool ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /graduates/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ³ط·آ·ط¢آ¬ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¹آ¾ط·آ·ط¢آ±ط·آ¸أ¢â‚¬ع‘ط·آ¸ط¸آ¹ط·آ·ط¢آ© ط£آ¢أ¢â€ڑآ¬أ¢â‚¬â€Œ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¹ sameSchool ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /promotion_logs/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ·ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¢آ¨ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ­ط·آ·ط¢آ°ط·آ¸ط«â€ ط·آ¸ط¸آ¾ط·آ¸ط«â€ ط·آ¸أ¢â‚¬آ  ط£آ¢أ¢â€ڑآ¬أ¢â‚¬â€Œ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¹ sameSchool ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /deleted_students/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ·ط¢آ²ط·آ¸ط¸آ¹ط·آ·ط¢آ¹ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸ط¸آ¾ط·آ·ط¢آµط·آ¸ط«â€ ط·آ¸أ¢â‚¬â€چ ط£آ¢أ¢â€ڑآ¬أ¢â‚¬â€Œ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¹ sameSchool ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /class_distribution/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ³ط·آ·ط¢آ¬ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¢آ´ط·آ·ط¹آ¾ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ¸ط¦â€™ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /subscription_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¹ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¢آ¶ط·آ¸ط¸آ¹ ط£آ¢أ¢â‚¬آ¢ط¹آ¯ط£آ¢أ¢â‚¬آ¢ط¹آ¯
    match /{document=**} {
      allow read, write: if false;
    }
  }
}