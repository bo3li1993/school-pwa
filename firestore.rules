rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userSchool() {
      return getUser().schoolId;
    }

    function userRole() {
      return getUser().role;
    }

    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'assistant_manager'];
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }

    function isTeacher() {
      return isAuth() && userRole() in ['teacher', 'social_worker', 'nurse', 'guard', 'wing_supervisor', 'department_head'];
    }

    function isParent() {
      return isAuth() && userRole() == 'parent';
    }

    function sameSchool(schoolId) {
      return isAuth() && userSchool() == schoolId;
    }

    function isSchoolStaff(schoolId) {
      return sameSchool(schoolId) && (isAdmin() || isTeacher());
    }

    // ط·ع¾ط·آ­ط¸â€ڑط¸â€ڑ: ط¸â€‍ط·آ§ ط¸ظ¹ط¸â€¦ط¸ئ’ط¸â€  ط·ع¾ط·ط›ط¸ظ¹ط¸ظ¹ط·آ± role ط·آ£ط¸ث† schoolId
    function roleNotChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId']);
    }

    // ط·ع¾ط·آ­ط¸â€ڑط¸â€ڑ: schoolId ط¸â€‍ط·آ§ ط¸ظ¹ط·ع¾ط·ط›ط¸ظ¹ط·آ± ط·آ¹ط¸â€ ط·آ¯ Update
    function schoolIdNotChanged() {
      return request.resource.data.schoolId == resource.data.schoolId;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط¸â€¦ط·آ¯ط·آ§ط·آ±ط·آ³ أ¢â€¢ع¯أ¢â€¢ع¯
    match /schools/{schoolId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط¸â€¦ط·آ³ط·ع¾ط·آ®ط·آ¯ط¸â€¦ط¸ث†ط¸â€  أ¢â€¢ع¯أ¢â€¢ع¯
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() && sameSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId) &&
        !request.resource.data.role.matches('superadmin');
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) &&
        roleNotChanged() &&
        schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ·ط¸â€‍ط·آ§ط·آ¨ أ¢â€¢ع¯أ¢â€¢ع¯
    match /students/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ­ط·آ¶ط¸ث†ط·آ± ط¸ث†ط·آ§ط¸â€‍ط·ط›ط¸ظ¹ط·آ§ط·آ¨ أ¢â€¢ع¯أ¢â€¢ع¯
    match /attendance/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ³ط¸â€‍ط¸ث†ط¸ئ’ أ¢â€¢ع¯أ¢â€¢ع¯
    match /behavior/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ¥ط¸â€ ط·آ°ط·آ§ط·آ±ط·آ§ط·ع¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /warnings/{docId} {
      allow read: if isAuth() && (
        isSchoolStaff(resource.data.schoolId) ||
        isParent() && sameSchool(resource.data.schoolId) &&
          resource.data.studentId in getUser().childIds
      );
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ§ط·آ³ط·ع¾ط·آ¦ط·آ°ط·آ§ط¸â€  أ¢â€¢ع¯أ¢â€¢ع¯
    match /gatepass/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ¹ط¸ظ¹ط·آ§ط·آ¯ط·آ© أ¢â€¢ع¯أ¢â€¢ع¯
    match /clinic/{docId} {
      allow read: if isAuth() && isSchoolStaff(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update, delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط¸ظ¾ط·آµط¸ث†ط¸â€‍ أ¢â€¢ع¯أ¢â€¢ع¯
    match /classes/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ£ط¸â€ڑط·آ³ط·آ§ط¸â€¦ أ¢â€¢ع¯أ¢â€¢ع¯
    match /departments/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ¥ط·آ¹ط¸â€‍ط·آ§ط¸â€ ط·آ§ط·ع¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /announcements/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ ط·آ§ط¸â€‍ط·آ¨ط·آ±ط¸ظ¹ط·آ¯ط¸ظ¹ أ¢â€¢ع¯أ¢â€¢ع¯
    match /school_threads/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isAuth() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط¸â€‍ط¸ث†ط·آ­ط·آ© ط·آ§ط¸â€‍ط·آ´ط·آ±ط¸ظ¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /honors_board/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط¸â€¦ط¸ئ’ط·آ§ط¸ظ¾ط·آ¢ط·ع¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /rewards/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ²ط¸ظ¹ط·آ§ط·آ±ط·آ§ط·ع¾ ط·آ§ط¸â€‍ط¸ظ¾ط¸â€ ط¸ظ¹ط·آ© أ¢â€¢ع¯أ¢â€¢ع¯
    match /technical_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ²ط¸ظ¹ط·آ§ط·آ±ط·آ§ط·ع¾ ط·آ§ط¸â€‍ط¸â€¦ط·آ¯ط¸ظ¹ط·آ± أ¢â€¢ع¯أ¢â€¢ع¯
    match /manager_visits/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAuth() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ¬ط¸ث†ط¸â€‍ط·آ§ط·ع¾ ط·آ§ط¸â€‍ط¸â€¦ط·آ´ط·آ±ط¸ظ¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /wing_rounds/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isSchoolStaff(request.resource.data.schoolId);
      allow update: if isSchoolStaff(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ³ط·آ¬ط¸â€‍ ط·آ§ط¸â€‍ط·ع¾ط·آ¯ط¸â€ڑط¸ظ¹ط¸â€ڑ أ¢â‚¬â€‌ ط¸â€¦ط¸â€ ط·آ¹ ط·آ§ط¸â€‍ط·ع¾ط·آ²ط¸ث†ط¸ظ¹ط·آ± أ¢â€¢ع¯أ¢â€¢ع¯
    match /audit_log/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط¸â€ ط·آ³ط·آ® ط·آ§ط¸â€‍ط·آ§ط·آ­ط·ع¾ط¸ظ¹ط·آ§ط·آ·ط¸ظ¹ط·آ© أ¢â€¢ع¯أ¢â€¢ع¯
    match /backups/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط¸â€ڑط·آ§ط·آ¦ط¸â€¦ط·آ© ط·آ§ط¸â€ ط·ع¾ط·آ¸ط·آ§ط·آ± ط·آ§ط¸â€‍ط·آ¥ط·آ´ط·آ¹ط·آ§ط·آ±ط·آ§ط·ع¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /notifications_queue/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط¸â€¦ط·آ­ط·آ§ط¸ث†ط¸â€‍ط·آ§ط·ع¾ ط·آ§ط¸â€‍ط·آ¯ط·آ®ط¸ث†ط¸â€‍ أ¢â€¢ع¯أ¢â€¢ع¯
    match /login_attempts/{docId} {
      allow read, write: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ£ط·آ±ط·آ´ط¸ظ¹ط¸ظ¾ أ¢â€¢ع¯أ¢â€¢ع¯
    match /archive_attendance/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_behavior/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }
    match /archive_warnings/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ®ط·آ±ط¸ظ¹ط·آ¬ط¸ث†ط¸â€  أ¢â‚¬â€‌ ط¸â€¦ط·آ¹ sameSchool أ¢â€¢ع¯أ¢â€¢ع¯
    match /graduates/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ³ط·آ¬ط¸â€‍ط·آ§ط·ع¾ ط·آ§ط¸â€‍ط·ع¾ط·آ±ط¸â€ڑط¸ظ¹ط·آ© أ¢â‚¬â€‌ ط¸â€¦ط·آ¹ sameSchool أ¢â€¢ع¯أ¢â€¢ع¯
    match /promotion_logs/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط·آ·ط¸â€‍ط·آ§ط·آ¨ ط·آ§ط¸â€‍ط¸â€¦ط·آ­ط·آ°ط¸ث†ط¸ظ¾ط¸ث†ط¸â€  أ¢â‚¬â€‌ ط¸â€¦ط·آ¹ sameSchool أ¢â€¢ع¯أ¢â€¢ع¯
    match /deleted_students/{docId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update, delete: if false;
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·ع¾ط¸ث†ط·آ²ط¸ظ¹ط·آ¹ ط·آ§ط¸â€‍ط¸ظ¾ط·آµط¸ث†ط¸â€‍ أ¢â‚¬â€‌ ط¸â€¦ط·آ¹ sameSchool أ¢â€¢ع¯أ¢â€¢ع¯
    match /class_distribution/{docId} {
      allow read: if isAuth() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && sameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && schoolIdNotChanged();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ³ط·آ¬ط¸â€‍ط·آ§ط·ع¾ ط·آ§ط¸â€‍ط·آ§ط·آ´ط·ع¾ط·آ±ط·آ§ط¸ئ’ أ¢â€¢ع¯أ¢â€¢ع¯
    match /subscription_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // أ¢â€¢ع¯أ¢â€¢ع¯ ط·آ§ط¸â€‍ط¸â€¦ط¸â€ ط·آ¹ ط·آ§ط¸â€‍ط·آ§ط¸ظ¾ط·ع¾ط·آ±ط·آ§ط·آ¶ط¸ظ¹ أ¢â€¢ع¯أ¢â€¢ع¯
    match /{document=**} {
      allow read, write: if false;
    }
  }
}